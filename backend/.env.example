# backend — copy to .env. Never commit .env (AGENTS.md §4.6).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ubmp
REDIS_URL=redis://localhost:6379
# Public origin of this API: webhook URLs, OAuth redirect, Twilio signature base, links in alerts.
PUBLIC_URL=http://localhost:4000
# Frontend origin(s), comma separated. Used for CORS and for links in Slack alerts.
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Session lifetimes
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_DAYS=7
# Google OAuth web client (authorized redirect URI: $PUBLIC_URL/calendar/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional platform-wide Slack bot token (xoxb-…); a workspace can instead connect its own on the Integrations page.
# Bot scopes needed: chat:write, users:read, users:read.email
SLACK_BOT_TOKEN=
LOG_LEVEL=info
# Optional: seed script values for the demo workspace
SEED_OWNER_EMAIL=owner@demo.test
SEED_OWNER_PASSWORD=Demo1234!

{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Business Management Platform API: accounts, CRM, lead engine, audit, dashboard and integrations",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "eslint \"src/**/*.ts\"",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.2.7",
    "@prisma/client": "^6.16.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.0",
    "fastify": "^5.11.3",
    "googleapis": "^160.0.0",
    "ioredis": "^5.7.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "stripe": "^18.5.0",
    "twilio": "^5.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^24.3.0",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
